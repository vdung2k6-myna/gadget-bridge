# The address the OTA response hands the device. Left unset, the bridge picks a
# LAN address itself; set it when that pick is wrong (a second adapter, a VPN).
#BRIDGE_PUBLIC_HOST=192.168.1.100

# Where the two servers listen.
#OTA_PORT=8003
#WS_PORT=8001

# Where gadget-console is, as a base URL. REQUIRED, and with no default: the
# obvious default is localhost, which is right on one machine and silently wrong
# on every other — the bridge would come up looking healthy and resolve nothing.
#BRIDGE_CONSOLE_URL=http://127.0.0.1:3001

# The bridge's own credential for the console, as the console has it in its .env.
# REQUIRED. It is sent only to the console, never to a gadget: a gadget
# authenticates with the token the OTA endpoint issues it, and with nothing else.
#BRIDGE_CONSOLE_TOKEN=

# How long a device resolution is reused before the console is asked again, in ms.
# A released gadget is refused no later than the end of this window; within it,
# the bridge keeps serving what it already resolved.
#BRIDGE_REGISTRY_TTL_MS=60000

# The downlink the bridge declares, and the uplink the gadget encodes at. These
# are not interchangeable: the sample count is part of what an Opus packet is read
# as, so a decoder built at the wrong rate fails outright rather than sounding
# sharp.
#BRIDGE_SERVER_RATE=24000
#BRIDGE_FRAME_MS=60
#BRIDGE_DEVICE_RATE=16000

# How many earlier turns a conversation carries into its next one.
#BRIDGE_HISTORY_TURNS=20

# How long after the floor is free a paired turn is released, in ms.
#BRIDGE_HANDOVER_MS=400

# How far one relative command moves a setting ("giảm âm lượng"), 0 to 100.
#BRIDGE_COMMAND_STEP=10

# How long a session may hold nobody before the bridge ends it, in ms. 0 turns the
# window off.
#BRIDGE_SESSION_IDLE_MS=60000

# Where this bridge's own music is. Empty means no music at all.
#BRIDGE_MUSIC_DIR=
# The level a track is played at, as a difference in dB from the file.
#BRIDGE_MUSIC_GAIN_DB=-10

# The endpointer: how the bridge knows the person has stopped speaking. All five
# are one decision, and their relation is checked at start.
#BRIDGE_VAD_MIN_RMS=500
#BRIDGE_VAD_FLOOR_RATIO=2.5
#BRIDGE_VAD_SILENCE_MS=900
#BRIDGE_VAD_MIN_SPEECH_MS=200
#BRIDGE_VAD_SPEECH_WINDOW_MS=2000
#BRIDGE_VAD_NO_SPEECH_MS=5000
#BRIDGE_MAX_TURN_MS=30000
# How long after the bridge's own audio the gadget's microphone is distrusted.
#BRIDGE_DRAIN_GUARD_MS=250
# How much audio before the first voiced frame to keep.
#BRIDGE_ONSET_LEAD_MS=200

# The settings the move to the console retired are refused rather than ignored:
# BRIDGE_ALLOWED_DEVICES, BRIDGE_DEVICE_PERSONAS, BRIDGE_DEVICE_LANGUAGES,
# BRIDGE_DEVICE_ENGINES, BRIDGE_DEVICE_PARTNERS, BRIDGE_DEVICE_SECRET,
# BRIDGE_PLATFORM_URL, API_AUTH_TOKEN, BRIDGE_LANGUAGE, BRIDGE_TURN_ENGINE.
# A gadget's owner, agent, language, engine, partner and secret live in the
# console; the runtime address and credential live on the agent.
